# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT — copy to `.env` and fill in. Nothing here is required for a
# first `pnpm dev`: the app falls back to the baked-in demo brand, a local
# SQLite database, on-disk media, and console-logged emails.
# ═══════════════════════════════════════════════════════════════════════════

# ── White-label brand (all optional; override the demo "Meridian & Voss") ──
# These are NEXT_PUBLIC_* so they are readable on the client. See src/config/site.ts.
NEXT_PUBLIC_SITE_NAME="Meridian & Voss"
NEXT_PUBLIC_LEGAL_NAME="Meridian & Voss SA"
NEXT_PUBLIC_SITE_TAGLINE="International Private Property House"
NEXT_PUBLIC_SITE_DESCRIPTION="Curators of the world's most exceptional residential and commercial properties."
NEXT_PUBLIC_SITE_URL="https://meridian-voss.com"
NEXT_PUBLIC_LOGO_SRC=""                 # leave blank to use the text wordmark
NEXT_PUBLIC_CONTACT_EMAIL="enquiries@meridian-voss.com"
NEXT_PUBLIC_CONTACT_PHONE="+41 22 555 0100"
NEXT_PUBLIC_CONTACT_ADDRESS="Rue du Rhône 67, 1204 Geneva"
NEXT_PUBLIC_CONTACT_CITY="Geneva"
NEXT_PUBLIC_CONTACT_COUNTRY="Switzerland"
NEXT_PUBLIC_ESTABLISHED="Est. Geneva, 1974"
NEXT_PUBLIC_FOUNDED_YEAR="1974"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="#"
NEXT_PUBLIC_SOCIAL_LINKEDIN="#"

# ── Presentation defaults ──
NEXT_PUBLIC_LOCALE="en-US"
NEXT_PUBLIC_LANG="en"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_UNIT_SYSTEM="metric"        # metric (m²) | imperial (ft²)

# ═══════════════════════════════════════════════════════════════════════════
# BACKEND — consumed from Phase 1 onward (CMS, database, media, email).
# Safe to leave commented for a first run; sensible local defaults apply.
# ═══════════════════════════════════════════════════════════════════════════

# ── Payload CMS ──
# Required in production. Generate a long random string (e.g. `openssl rand -hex 32`).
PAYLOAD_SECRET="change-me-to-a-long-random-string"

# ── Database ──
# DB_ADAPTER: "sqlite" (zero-config local trial) | "postgres" (production).
DB_ADAPTER="sqlite"
# SQLite file location when DB_ADAPTER=sqlite (default: ./meridian.db)
DATABASE_URI="file:./meridian.db"
# For Postgres, set DB_ADAPTER=postgres and a connection string:
# DATABASE_URI="postgres://user:password@host:5432/dbname"

# ── Media storage ──
# STORAGE_ADAPTER: "local" (on-disk, dev) | "s3" (production; ephemeral FS-safe).
STORAGE_ADAPTER="local"
# S3 / R2 / Spaces-compatible settings when STORAGE_ADAPTER=s3:
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""                        # e.g. https://<accountid>.r2.cloudflarestorage.com
# NEXT_PUBLIC_MEDIA_URL=""              # public base URL for served media

# ── Email (lead capture) ──
# Provider auto-selected by which keys are set. If neither, emails are logged to console.
# Option A — Resend:
# RESEND_API_KEY=""
# Option B — SMTP (Nodemailer):
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# Where lead notifications are delivered (defaults to NEXT_PUBLIC_CONTACT_EMAIL):
# LEAD_NOTIFY_EMAIL=""
# From-address for outgoing mail:
# EMAIL_FROM="Meridian & Voss <no-reply@meridian-voss.com>"
